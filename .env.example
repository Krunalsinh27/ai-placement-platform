# ==============================================================================
# AI Placement Intelligence Platform - Root Environment Reference Template
# ==============================================================================
# Copy this file to `server/.env` and `client/.env` respectively, configuring
# the appropriate environment variables for each subsystem.
# NEVER commit real credentials, API keys, or JWT secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER CONFIGURATION (Used in server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend Application Origin & Cross-Origin Security
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Connections (Dedicated test database isolated from development)
MONGO_URI=mongodb://localhost:27017/placement_management
MONGO_URI_TEST=mongodb://localhost:27017/placement_management_test

# Redis Connection & BullMQ Queue Infrastructure
# Required in production; falls back gracefully to in-memory queues when offline in dev/test
REDIS_URL=redis://127.0.0.1:6379
RUN_WORKER_IN_API=true
HEALTH_DETAIL_KEY=

# Authentication Security (Must be at least 32 characters in production)
JWT_SECRET=supersecretjwtkey_placement_system_2026_at_least_32_chars
JWT_REFRESH_SECRET=supersecretjwtrefreshkey_placement_system_2026_at_least_32_chars

# Cookie Security Settings
COOKIE_SAMESITE=none
COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# Email Delivery Configuration (smtp, brevo, or console)
EMAIL_MODE=console
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Placement Portal" <noreply@placementportal.edu>
EMAIL_DEV_ALLOWLIST=developer@example.com
EMAIL_MAX_PER_MINUTE=20

# Storage Driver: "local" (default in dev/test) or "gridfs" (default in production)
STORAGE_DRIVER=local

# Placement Policies & Demo Modes
BLOCK_PLACED_STUDENTS=false
DEMO_SHOW_OTP=false
ALLOW_PRODUCTION_SEED=false

# Initial Admin & Superadmin Provisioning
ADMIN_PASSWORD=change_this_to_strong_admin_password
SUPERADMIN_EMAIL=superadmin@yourdomain.com
SUPERADMIN_PASSWORD=change_this_to_a_strong_password_min_12_chars
SUPERADMIN_NAME="System Superadmin"

# ------------------------------------------------------------------------------
# 2. AI PROVIDER & FALLBACK RELIABILITY CONFIGURATION (Used in server/.env)
# ------------------------------------------------------------------------------
# Master Provider: "groq", "gemini", "mock", "rules", or "none" (default: "none")
# "mock" is strictly prohibited when NODE_ENV=production.
AI_PROVIDER=none

# Fallback Configuration
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=gemini
AI_PROVIDER_CHAIN=groq,gemini,rules
AI_REQUEST_TIMEOUT_MS=12000

# Provider-Specific Configuration: Groq
# Note: Groq never receives Gemini credentials or Gemini models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Provider-Specific Configuration: Google Gemini
# Note: Gemini never receives Groq credentials or Llama models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_OCR=gemini-1.5-flash
GEMINI_MODEL_EMBEDDING=text-embedding-004

# Legacy AI Settings (Backward Compatibility: only used if provider-specific keys are unset)
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_MODEL_FAST=llama-3.1-8b-instant

# Daily Quotas (Persisted in MongoDB)
AI_DAILY_CALL_CAP=400
AI_USER_DAILY_PARSE_CAP=5
AI_USER_DAILY_ANALYZE_CAP=10
AI_USER_DAILY_CHAT_CAP=30
AI_USER_DAILY_MOCK_CAP=5
AI_USER_DAILY_TAILOR_CAP=10

# Resume Studio: Max Unsubmitted Draft Versions
RESUME_STUDIO_MAX_VERSIONS=20

# Feature Flags
AI_FEATURE_RESUME_PARSE=true
AI_FEATURE_RESUME_ANALYZE=true
AI_FEATURE_ASSISTANT=true
AI_FEATURE_MOCK_INTERVIEW=true
AI_FEATURE_RESUME_BUILDER=true
AI_FEATURE_RECOMMENDATIONS=true
AI_FEATURE_SKILL_GAP=true
AI_FEATURE_TPO_INSIGHTS=true

# ------------------------------------------------------------------------------
# 3. CLIENT FRONTEND CONFIGURATION (Used in client/.env)
# ------------------------------------------------------------------------------
# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
