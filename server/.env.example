PORT=5000
NODE_ENV=development

# Frontend Client URL (used for CORS origin restriction & redirect links)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Connections
MONGO_URI=mongodb://localhost:27017/placement_management
MONGO_URI_TEST=mongodb://localhost:27017/placement_management_test

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=supersecretjwtkey_placement_system_2026_at_least_32_chars
JWT_REFRESH_SECRET=supersecretjwtrefreshkey_placement_system_2026_at_least_32_chars
COOKIE_SAME_SITE=lax

# Placement Eligibility Policy
BLOCK_PLACED_STUDENTS=false

# Optional Demo Helper (Default: false)
# When set to true in non-production (NODE_ENV != 'production'), register and resend responses
# include 'devOtp', and the verify page displays it in a yellow "Demo mode" banner.
# The server refuses this flag when NODE_ENV=production.
DEMO_SHOW_OTP=false

# Email Mode: "smtp" (default if configured) or "console" (forces simulated console printing)
EMAIL_MODE=smtp

# SMTP Email Configuration
# Set SMTP_HOST, SMTP_USER, and SMTP_PASS to enable real email delivery.
# If unconfigured or EMAIL_MODE=console, OTPs and notifications fall back to the terminal console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Use 465 for SSL (SMTP_SECURE=true), or 587 for STARTTLS (SMTP_SECURE=false)

# Gmail Configuration Steps:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create a new App Password (name it e.g. "Placement Portal").
# 4. Copy the generated 16-character code and paste below in SMTP_PASS.
#    (Spaces in the 16-character password are automatically stripped by the server).
SMTP_USER=your-email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Default sender address (defaults to SMTP_USER if omitted)
MAIL_FROM="Placement Portal" <noreply@placementportal.edu>

# Development Email Safety Allowlist (comma-separated list of addresses)
# In non-production environments (NODE_ENV != 'production'), real SMTP will ONLY send to
# recipient addresses listed in EMAIL_DEV_ALLOWLIST. All other addresses (including seeded/test
# addresses like @portal.com, @college.com) are safely simulated in console without contacting SMTP.
EMAIL_DEV_ALLOWLIST=developer@example.com

# SMTP Rate Cap (Default: 20 per minute)
# Caps the maximum number of real emails that can be dispatched via SMTP per minute to prevent accidental mailbox flooding.
EMAIL_MAX_PER_MINUTE=20
