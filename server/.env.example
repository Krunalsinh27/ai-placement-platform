PORT=5000
NODE_ENV=development

# Frontend Client URL (used for CORS origin restriction & redirect links)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Connections
MONGO_URI=mongodb://localhost:27017/placement_management
MONGO_URI_TEST=mongodb://localhost:27017/placement_management_test

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=supersecretjwtkey_placement_system_2026_at_least_32_chars
JWT_REFRESH_SECRET=supersecretjwtrefreshkey_placement_system_2026_at_least_32_chars

# Cookie Configuration for Cross-Site or Shared-Site Deployments
# Mode 1 (Cross-Site Render + Vercel): leave COOKIE_DOMAIN unset, COOKIE_SAMESITE=none, COOKIE_SECURE=true
# Mode 2 (Shared-Site same domain): COOKIE_DOMAIN=.example.com, COOKIE_SAMESITE=lax, COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# Placement Eligibility Policy
BLOCK_PLACED_STUDENTS=false

# Optional Demo Helper (Default: false)
# When set to true in non-production (NODE_ENV != 'production'), register and resend responses
# include 'devOtp', and the verify page displays it in a yellow "Demo mode" banner.
# The server refuses this flag when NODE_ENV=production.
DEMO_SHOW_OTP=false

# Storage Driver: "local" (default in development and test) or "gridfs" (MongoDB GridFS, default in production)
STORAGE_DRIVER=local

# Email Mode: "smtp", "brevo", or "console" (forces simulated console printing)
EMAIL_MODE=smtp

# Email Delivery Provider: "smtp" (default) or "brevo" (HTTPS API without external SDK)
EMAIL_PROVIDER=smtp

# Brevo (Sendinblue) HTTP API Configuration (Used when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@placementportal.edu
BREVO_SENDER_NAME=Placement Portal

# SMTP Email Configuration
# Set SMTP_HOST, SMTP_USER, and SMTP_PASS to enable real email delivery.
# If unconfigured or EMAIL_MODE=console, OTPs and notifications fall back to the terminal console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Use 465 for SSL (SMTP_SECURE=true), or 587 for STARTTLS (SMTP_SECURE=false)

# Gmail Configuration Steps:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create a new App Password (name it e.g. "Placement Portal").
# 4. Copy the generated 16-character code and paste below in SMTP_PASS.
#    (Spaces in the 16-character password are automatically stripped by the server).
SMTP_USER=your-email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Default sender address (defaults to SMTP_USER if omitted)
MAIL_FROM="Placement Portal" <noreply@placementportal.edu>

# Development Email Safety Allowlist (comma-separated list of addresses)
# In non-production environments (NODE_ENV != 'production'), real SMTP will ONLY send to
# recipient addresses listed in EMAIL_DEV_ALLOWLIST. All other addresses (including seeded/test
# addresses like @portal.com, @college.com) are safely simulated in console without contacting SMTP.
EMAIL_DEV_ALLOWLIST=developer@example.com

# SMTP Rate Cap (Default: 20 per minute)
# Caps the maximum number of real emails that can be dispatched via SMTP per minute to prevent accidental mailbox flooding.
EMAIL_MAX_PER_MINUTE=20

# Database Seeding Guards
# When NODE_ENV=production, `npm run seed` will refuse to run unless explicitly overridden.
ALLOW_PRODUCTION_SEED=false

# Initial Admin & Superadmin Provisioning
# In production, seedAdmin and seedSuperadmin read credentials from env or generate a random one printed once.
ADMIN_PASSWORD=change_this_to_strong_admin_password
SUPERADMIN_EMAIL=superadmin@yourdomain.com
SUPERADMIN_PASSWORD=change_this_to_a_strong_password_min_12_chars
SUPERADMIN_NAME="System Superadmin"

# AI Resume Parsing & Explainable Matching Configuration
# Provider: "groq", "gemini", "mock", or "none" (default: "none"). "mock" is forbidden in production.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# Smaller fast model for TPO assistant intent routing (optional, falls back to AI_MODEL)
AI_MODEL_FAST=llama-3.1-8b-instant
# Daily global call cap persisted in MongoDB
AI_DAILY_CALL_CAP=400
# Daily personal parsing cap per candidate
AI_USER_DAILY_PARSE_CAP=5
# Daily personal resume analysis cap per candidate (separate from parsing cap)
AI_USER_DAILY_ANALYZE_CAP=10
# Daily personal assistant chat cap per user (separate from parsing and analyze caps)
AI_USER_DAILY_CHAT_CAP=30

